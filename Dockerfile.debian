# base image は digest で固定する。tag は動くため、同じ Dockerfile が時期によって別の
# base で build され、手元で通った build と公開される image が別物になり得る。
FROM node:26-trixie@sha256:32fa97f3363975684b08bf4e8a68a47c7905175cc20275b50b974bbd02aba731 AS client-builder
COPY client/package*.json /app/client/
WORKDIR /app/client
# どこで時間が掛かっているのか確認できるようにログレベルを変更。
# npm が取得した package は cache mount（/root/.npm）に残し、lockfile が変わって npm ci をやり直すときに
# 手元にある分を取得し直さない。cache mount の中身は image にも層にも入らない。
RUN --mount=type=cache,target=/root/.npm npm ci --loglevel=info \
    --fetch-retries=10 --fetch-retry-mintimeout=100000 --fetch-retry-maxtimeout=600000
# client の bundle は client フォルダーの中だけで完結するので、client フォルダーだけをコピーする。
# client 以外の変更では bundle を作り直さない。
COPY client/ /app/client/
# image build は組み立てだけを行う。lint、typecheck、unit test は CI の gate が実行する。
# bundle の成果物は client/dist にあり、最終 stage はこれだけをコピーする。
RUN npm run bundle --loglevel=info

# サーバーはbetter-sqlite3やfs-extのようなプラットフォーム依存のネイティブ・アドオンを含んでいる。
# そのため、各TARGETPLATFORMごとにソースをビルドしなければならない。
FROM node:24-trixie-slim@sha256:173f125896c3b47ddf056734c7ea789d04595a6a08769a8f78e0df642781fb66 AS server-deps
ENV DEBIAN_FRONTEND=noninteractive
# base は最終 stage と同じ slim とし、native addon の build に要る compiler と python3 は apt で入れる。
# apt の cache（/var/cache/apt・/var/lib/apt）は cache mount に置き、OS の層を作り直すときに .deb と
# package の一覧を取得し直さない。base image の docker-clean は install のあとで .deb を消すので外す。
# 外せば、apt-get は既定で .deb を残す。一覧の無い cache mount で install だけが走らないよう、update と
# install は同じ RUN で行う。
RUN rm -f /etc/apt/apt.conf.d/docker-clean
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends build-essential python3
WORKDIR /app
COPY package*.json /app/
ENV DOCKER="YES"
# fs-ext の build で node-gyp は、Node の header を Node 自身が示す取得先
# （process.release.headersUrl、debian では nodejs.org）から download する。回線が遅いと
# この download が ETIMEDOUT で失敗する。base image は同じ版の header を
# /usr/local/include/node に持っているので、それを使わせて download そのものを無くす。
# 指定は npm_config_ 接頭辞ではなく npm_package_config_node_gyp_ の形にする。node-gyp の
# README は npm_config_ 接頭辞を npm@11 で deprecated、npm@12 で削除としており、この形が推奨。
ENV npm_package_config_node_gyp_nodedir=/usr/local
# lockfile どおりに入れる。`npm install` は package.json とずれていれば解決し直すため、
# 公開する image の依存が lockfile と一致する保証がない。`--no-save` はその書き換えを
# 抑えるだけで、従わせる指定ではない。
# npm が取得した package は cache mount（/root/.npm）に残し、lockfile が変わって npm ci をやり直すときに
# 手元にある分を取得し直さない。cache mount の中身は image にも層にも入らない。
RUN --mount=type=cache,target=/root/.npm npm ci --loglevel=info \
    --fetch-retries=10 --fetch-retry-mintimeout=100000 --fetch-retry-maxtimeout=600000

# compile と依存の整理に要るのは server-deps の node_modules だけで、OS の package は要らない。そのため
# server-builder と server-prod-deps は最終 stage と同じ base の上に作り、node_modules を bind mount か
# コピーで受け取る。bind mount もコピーも中身で cache を判定するので、OS の package の行が変わっても、
# node_modules が同じならこの 2 つの stage は作り直さない。
# 同じく組み立てだけを行う。lint、format、静的検査は CI の gate が実行する。
FROM node:24-trixie-slim@sha256:173f125896c3b47ddf056734c7ea789d04595a6a08769a8f78e0df642781fb66 AS server-builder
WORKDIR /app
COPY package.json tsconfig.json api.d.ts /app/
COPY src/ /app/src/
RUN --mount=type=bind,from=server-deps,source=/app/node_modules,target=/app/node_modules \
    npm run compile

# 開発用の package（devDependencies）を取り除く。lockfile で入れた node_modules から消すだけで、
# 外部へは取りに行かない。package を消すので、node_modules は読み取り専用の bind mount ではなく
# コピーで受け取る。
FROM node:24-trixie-slim@sha256:173f125896c3b47ddf056734c7ea789d04595a6a08769a8f78e0df642781fb66 AS server-prod-deps
WORKDIR /app
COPY package*.json /app/
COPY --from=server-deps /app/node_modules /app/node_modules/
RUN npm prune --omit=dev

FROM node:24-trixie-slim@sha256:173f125896c3b47ddf056734c7ea789d04595a6a08769a8f78e0df642781fb66
LABEL maintainer="l3tnun"
# 実行時に読むファイル（api.yml、img、config の template など）は、一覧を持たずに build context ごと
# コピーする。一覧を持つと、ファイルを追加するたびに Dockerfile の変更が要る。node_modules は
# .dockerignore で除かれるので、依存と build の成果物はこのあとで各 stage から重ねる。
COPY . /app/
COPY --from=server-prod-deps /app/node_modules /app/node_modules/
COPY --from=server-builder /app/dist /app/dist/
COPY --from=client-builder /app/client/dist /app/client/dist/
EXPOSE 8888
WORKDIR /app
ENTRYPOINT ["npm"]
CMD ["start"]
