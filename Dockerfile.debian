# クライアントはプラットフォーム依存のコードを含まないため、BUILDPLATFORMでビルドした結果を
# 全てのTARGETPLATFORMで再利用できる。これによりビルド時間を短縮できる。
# base image は digest で固定する。tag は動くため、同じ Dockerfile が時期によって別の
# base で build され、手元で通った build と公開される image が別物になり得る。
FROM --platform=$BUILDPLATFORM node:26-bookworm@sha256:f1233c415b41ffcf237c717b3dea92e9d4ea006e0e4c71edcb790605d74f5404 AS client-builder
COPY client/package*.json /app/client/
WORKDIR /app/client
RUN npm config set fetch-retries 10 \
    && npm config set fetch-retry-mintimeout 100000 \
    && npm config set fetch-retry-maxtimeout 600000
# どこで時間が掛かっているのか確認できるようにログレベルを変更。
RUN npm ci --loglevel=info
# clientフォルダー外にビルドに必要なファイルが存在するため、全てコピーする。
COPY . /app/
WORKDIR /app/client
# image build は組み立てだけを行う。lint、typecheck、unit test は CI の gate が実行する。
# bundle の成果物は client/dist にある。最終 image は実行に要らない client の node_modules を
# 含めないため、bundle のあとで削除する。
RUN npm run bundle --loglevel=info \
    && rm -rf node_modules

# サーバーはsqlite3のようなプラットフォーム依存のネイティブ・アドオンを含んでいる。そのため、各
# TARGETPLATFORMごとにソースをビルドしなければならない。BUILDPLATFORM以外のTARGETPLATFORMでは、QEMU
# 上でnpmコマンドを実行することになるため、どうしても時間が掛かる。
#
# `npm install`時にネイティブ・アドオンをクロスビルドできればビルド時間を短縮できるが、現時点では明
# 確な手順は存在しない。https://github.com/mapbox/node-pre-gyp/issues/348を見ればそれが分かる。
#
# サーバーのコンパイルはプラットフォーム依存処理を含まないため、これをBUILDPLATFORMで実行すること
# でビルド時間をさらに短縮可能だが、手順が煩雑で面倒なので現時点では行っていない。
FROM node:24-bookworm@sha256:3d27e5c11e5786e309ec3e03f93ae536eb36e6e5eb3714d5eb3300a36157add0 AS server-builder
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update
RUN apt-get install -y build-essential python3
WORKDIR /app
COPY package*.json /app/
ENV DOCKER="YES"
# fs-ext の build で node-gyp は、Node の header を Node 自身が示す取得先
# （process.release.headersUrl、debian では nodejs.org）から download する。回線が遅いと
# この download が ETIMEDOUT で失敗する。base image は同じ版の header を
# /usr/local/include/node に持っているので、それを使わせて download そのものを無くす。
# 指定は npm_config_ 接頭辞ではなく npm_package_config_node_gyp_ の形にする。node-gyp の
# README は npm_config_ 接頭辞を npm@11 で deprecated、npm@12 で削除としており、この形が推奨。
ENV npm_package_config_node_gyp_nodedir=/usr/local
RUN npm config set fetch-retries 10 \
    && npm config set fetch-retry-mintimeout 100000 \
    && npm config set fetch-retry-maxtimeout 600000
# lockfile どおりに入れる。`npm install` は package.json とずれていれば解決し直すため、
# 公開する image の依存が lockfile と一致する保証がない。`--no-save` はその書き換えを
# 抑えるだけで、従わせる指定ではない。
RUN npm ci --loglevel=info
# 最終イメージのサイズ削減のため、すべてコピーした後でclientフォルダーを削除。clientフォルダー以外
# をコピーする方法は，ファイルが追加された場合に変更する必要があるため採用しない。
COPY . .
RUN rm -rf client
# 同じく組み立てだけを行う。lint、format、静的検査は CI の gate が実行する。
# compile のあとで開発用の package（devDependencies）を取り除く。lockfile で入れた node_modules から
# 消すだけで、外部へは取りに行かない。
RUN npm run compile \
    && npm prune --omit=dev

FROM node:24-bookworm-slim@sha256:d6aa754f16b3197301076f047b5def2f02ea1dbbc2ca920407d46d7ec7f87b20
LABEL maintainer="l3tnun"
COPY --from=server-builder /app /app/
COPY --from=client-builder /app/client /app/client/
EXPOSE 8888
WORKDIR /app
ENTRYPOINT ["npm"]
CMD ["start"]
