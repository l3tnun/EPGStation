# EPGStation client device lab local environment.
#
# Copy this file to:
#
#   client/device/.device-lab.local.env
#
# The copied file is git ignored. Do not commit it. Put every machine-specific
# path, LAN URL, SSH target, and credential-related value in the copied local
# file instead of tracked documentation.

# Current EPGStation UI used for device checks.
# Example value shape only:
#   http://<host-or-ip>:<port>/
export EPGSTATION_CURRENT_UI_URL="<current-epgstation-ui-url>"

# ---------------------------------------------------------------------------
# iOS Simulator on remote macOS
# ---------------------------------------------------------------------------

export EPGSTATION_IOS_MAC_SSH_HOST="<mac-ssh-host>"
export EPGSTATION_IOS_MAC_NODE_BIN_DIR="<mac-node-bin-dir>"
export EPGSTATION_IOS_MAC_APPIUM_WORKDIR="<mac-appium-workdir>"
export EPGSTATION_IOS_MAC_APPIUM_LOG="<mac-appium-log-path>"
export EPGSTATION_IOS_MAC_APPIUM_PID_FILE="<mac-appium-pid-file>"
export EPGSTATION_IOS_APPIUM_URL="http://127.0.0.1:<ios-appium-local-port>"
export EPGSTATION_IOS_SIM_DEVICE_NAME="iPhone 16 Pro"

# ---------------------------------------------------------------------------
# Android Emulator on this workstation
# ---------------------------------------------------------------------------

export EPGSTATION_ANDROID_JAVA_HOME="<jdk-21-install-dir>"
export EPGSTATION_ANDROID_SDK_ROOT="<android-sdk-root>"
export EPGSTATION_ANDROID_AVD_HOME="<android-avd-home>"
export EPGSTATION_ANDROID_APPIUM_WORKDIR="<android-appium-workdir>"
export EPGSTATION_ANDROID_CMDLINE_TOOLS_ZIP="<android-commandline-tools-zip-or-url>"
export EPGSTATION_ANDROID_EMULATOR_ZIP_35_6_9="<android-emulator-35.6.9-zip-or-url>"
export EPGSTATION_ANDROID_AVD_NAME="epgstation_pixel_8_api35_googleapis"
export EPGSTATION_ANDROID_APPIUM_URL="http://127.0.0.1:4725"
