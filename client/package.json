{
  "name": "epgstation-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run bundle",
    "bundle": "vite build",
    "build:verify": "npm run lint && npm run typecheck && npm run test:run -- --no-file-parallelism && npm run build",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:dev-server && npm run test:spec && npm run test:imp",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "test:dev-server": "node scripts/verify-vite-dev-server.mjs",
    "test:spec": "vitest run unittest/spec",
    "test:imp": "vitest run unittest/imp",
    "test:run": "vitest run unittest",
    "coverage": "vitest run unittest --coverage",
    "coverage:gate": "VITEST_COVERAGE_GATE=1 vitest run unittest --coverage",
    "e2e": "playwright test e2e",
    "visual": "playwright test visual",
    "device:smoke": "node device/run-device-tests.mjs --suite smoke",
    "device:workflow": "node device/run-device-tests.mjs --suite workflow",
    "device:visual": "node device/run-device-tests.mjs --suite visual",
    "device:all": "node device/run-device-tests.mjs --suite all",
    "preview": "vite preview"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mdi/font": "^7.4.47",
    "@mui/material": "9.4.0",
    "@mui/x-date-pickers": "9.14.0",
    "@tanstack/react-query": "5.104.0",
    "aribb24.js": "2.0.26",
    "dayjs": "1.11.23",
    "hls.js": "1.7.3",
    "mpegts.js": "1.8.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "react-router-dom": "7.18.4",
    "socket.io-client": "4.8.4",
    "typeface-roboto": "^1.1.13",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.11.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.1",
    "msw": "2.15.0",
    "prettier": "3.9.9",
    "socket.io": "4.8.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "overrides": {
    "webworkify-webpack": "2.1.5"
  }
}
