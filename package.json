{
    "name": "epgstation",
    "version": "2.10.0",
    "description": "DTV Software in Japan.",
    "main": "dist/index.js",
    "type": "module",
    "scripts": {
        "all-install": "npm i --no-save && mise exec -C client -- npm i --no-save",
        "start": "node dist/index.js",
        "build": "npm run build-server && npm run build-client",
        "build-server": "npm run lint:src && npm run format && npm run compile",
        "build-client": "mise exec -C client -- npm run build",
        "test:server:build": "node scripts/server-test/build.mjs",
        "test:server:spec": "node scripts/server-test/run-tests.mjs spec",
        "test:server:imp": "node scripts/server-test/run-tests.mjs imp",
        "test:server:integration": "node scripts/server-test/run-tests.mjs integration",
        "test:server": "node scripts/server-test/run-tests.mjs all",
        "test:server:coverage": "node scripts/server-test/run-tests.mjs coverage",
        "lint": "eslint --fix src/ test/server/ scripts/server-test/",
        "lint:src": "eslint --fix src/",
        "lint:check": "eslint src/ test/server/ scripts/server-test/",
        "format": "prettier --check --write 'src/**/*.ts'",
        "format:check": "prettier --check 'src/**/*.ts'",
        "typecheck": "tsc --noEmit",
        "compile": "tsc",
        "watch": "tsc --watch",
        "orm-gen": "typeorm migration:generate src/db/migrations/${npm_config_db}/${npm_config_name} -d ./ormconfig.js",
        "orm-run": "typeorm migration:run -d ./ormconfig.js",
        "backup": "node dist/DBTools.js -m backup -o",
        "restore": "node dist/DBTools.js -m restore -o",
        "v1migrate": "node dist/V1MigrationTool.js -i",
        "install-win-service": "winser -i -a",
        "uninstall-win-service": "winser -r -x",
        "test": "echo \"Error: no test specified\" && exit 1",
        "ci": "npm run test:server && npm --prefix client run test:run",
        "preflight": "bash scripts/release-preflight.sh"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/l3tnun/EPGStation-V2.git"
    },
    "author": "l3tnun",
    "license": "MIT",
    "engines": {
        "node": ">=24"
    },
    "bugs": {
        "url": "https://github.com/l3tnun/EPGStation-V2/issues"
    },
    "homepage": "https://github.com/l3tnun/EPGStation-V2#readme",
    "dependencies": {
        "arib-subtitle-timedmetadater": "4.0.10",
        "aribts": "2.1.12",
        "axios": "1.20.0",
        "better-sqlite3": "12.11.1",
        "body-parser": "2.3.0",
        "cors": "2.8.6",
        "diskusage-ng": "1.0.4",
        "eventsource": "5.1.2",
        "express": "5.2.1",
        "express-openapi": "12.1.3",
        "file-type": "22.1.1",
        "fs-ext": "2.1.1",
        "inversify": "8.2.3",
        "js-yaml": "5.4.2",
        "lodash": "4.18.1",
        "log4js": "6.9.1",
        "minimist": "1.2.8",
        "mkdirp": "3.0.1",
        "multer": "2.4.0",
        "mysql2": "3.24.5",
        "openapi-types": "12.1.3",
        "reflect-metadata": "0.2.2",
        "socket.io": "4.8.4",
        "source-map-support": "0.5.21",
        "swagger-ui-dist": "5.33.1",
        "typeorm": "1.1.1",
        "url-join": "5.0.0"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/body-parser": "1.19.6",
        "@types/express": "5.0.6",
        "@types/js-yaml": "4.0.9",
        "@types/lodash": "4.17.25",
        "@types/minimist": "1.2.5",
        "@types/multer": "2.3.0",
        "@types/node": "24.19.1",
        "@types/socket.io": "3.0.2",
        "@types/source-map-support": "0.5.10",
        "@vitest/coverage-v8": "5.0.3",
        "eslint": "10.11.0",
        "eslint-config-prettier": "10.1.8",
        "globals": "17.13.0",
        "picomatch": "4.0.7",
        "prettier": "3.9.9",
        "sqlite-regex": "0.2.4-alpha.1",
        "typescript": "6.0.3",
        "typescript-eslint": "8.71.0",
        "vite": "8.3.2",
        "vitest": "5.0.3"
    }
}
